version: v4
volumes:
  initial-data:
    use: team15-scratch
    size: 20GiB
    ingress:
    - source:
        uri: fb://user/ember/arrival-pilot-20261114-02/input.tgz
      destination:
        uri: file://input.tgz
    egress:
    - source:
        uri: file://results.tgz
      destination:
        uri: fb://user/ember/arrival-pilot-20261114-02/initial-results.tgz
jobs:
  initial:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:26.10-py3
    mounts:
      /work: initial-data
    resource:
      cpu:
        cores: 4
      memory:
        size: 16GiB
      devices:
        nvidia.com/gpu: 1
    script: '#!/bin/bash

      set -euo pipefail

      export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONUNBUFFERED=1

      tar -xzf /work/input.tgz -C /work

      cd /work

      python3 -c ''import torch, numpy, yaml; print(torch.__version__)''

      python3 -m pip freeze > /work/pilot/initial_environment.txt

      python3 orchestration/fuzzball/execute_training.py train --config /work/pilot/initial.yaml
      2>&1 | tee /work/pilot/initial_workflow.log

      python3 orchestration/fuzzball/execute_training.py evaluate --config /work/pilot/initial.yaml
      2>&1 | tee -a /work/pilot/initial_workflow.log

      tar -czf /work/results.tgz -C /work pilot/outputs_initial pilot/initial.yaml
      pilot/dataset_manifest.json pilot/package_manifest.json pilot/initial_workflow.log
      pilot/initial_environment.txt

      '
